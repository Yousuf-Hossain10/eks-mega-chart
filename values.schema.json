{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "eks-mega-chart values",
  "description": "Validates the values contract at install/template time. See docs/what-is-this.md and docs/values-schema.md for what this can and cannot catch.",
  "type": "object",
  "required": [
    "replicaCount",
    "strategy",
    "image",
    "service",
    "resources",
    "autoscaling",
    "securityContext",
    "pdb",
    "topologySpreadConstraints"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Must be at least 1 - a Deployment with 0 replicas serves no traffic."
    },
    "strategy": {
      "type": "object",
      "required": ["maxSurge", "maxUnavailable"],
      "properties": {
        "maxSurge": { "type": "integer", "minimum": 0 },
        "maxUnavailable": { "type": "integer", "minimum": 0 }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "latest" },
          "anyOf": [
            { "pattern": "^[0-9a-f]{7,40}$" },
            { "pattern": "^v?[0-9]+(\\.[0-9]+){1,3}(-[0-9A-Za-z.]+)?$" },
            { "pattern": "^sha256:[0-9a-f]{64}$" }
          ],
          "description": "Must be an immutable reference: a git SHA, a semver-ish version tag (nginx:1.25.4, alpine:3.19), or a digest. 'latest' is rejected outright. Chosen over the stricter SHA-only pattern specifically so third-party images (e.g. the kind smoke test's nginx image) are representable in the chart's own values contract, not just this org's app images."
        }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": ["string", "null"] }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": "integer", "minimum": 30000, "maximum": 32767 },
        "annotations": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests"],
      "description": "Per ADR-0002: CPU gets a request but no limit (CPU is compressible, a limit only throttles); memory request must equal memory limit (memory is not compressible, and this prevents the scheduler from overcommitting a node's real memory ceiling). Not structurally enforced here - like autoscaling.maxReplicas vs minReplicas, 'requests.memory == limits.memory' is a cross-field comparison JSON Schema can't express; see docs/adr/0002-resource-limits.md.",
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|K|M|G)?$" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|K|M|G)?$" }
          }
        }
      }
    },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "description": "maxReplicas >= minReplicas is a cross-field comparison JSON Schema cannot express here; it is enforced separately in templates/hpa.yaml via a template 'fail' guard.",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "behavior": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": {
      "type": "object",
      "required": [
        "runAsNonRoot",
        "readOnlyRootFilesystem",
        "allowPrivilegeEscalation",
        "capabilities"
      ],
      "description": "These four are CLAUDE.md non-negotiables, pinned with const so no environment overlay can silently weaken them.",
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "readOnlyRootFilesystem": { "const": true },
        "allowPrivilegeEscalation": { "const": false },
        "seccompProfile": { "type": "object" },
        "capabilities": {
          "type": "object",
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "contains": { "const": "ALL" }
            }
          }
        }
      }
    },
    "pdb": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 1 }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "topologyKey": { "type": "string", "minLength": 1 },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": ["DoNotSchedule", "ScheduleAnyway"]
        }
      }
    },
    "configData": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "secretData": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "httpGet": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "port": {}
          }
        },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
